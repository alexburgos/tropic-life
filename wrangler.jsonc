{
	// This is a Worker serving static assets only — the whole site is prerendered by
	// adapter-static, so there is no `main` entry point and no server-side code.
	//
	// `name` must match the Worker created in Cloudflare, or `wrangler deploy` will
	// create a second one and the custom domain will stay pointed at the old Worker.
	"name": "tropic-life",
	"compatibility_date": "2026-08-07",
	"assets": {
		"directory": "./build"
	}
}
